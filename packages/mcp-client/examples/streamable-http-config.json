{
  "version": "1.0.0",
  "servers": {
    "modern-ai-assistant": {
      "id": "modern-ai-assistant",
      "name": "Modern AI Assistant Server",
      "description": "AI assistant with modern Streamable HTTP transport",
      "transport": {
        "type": "streamable-http",
        "url": "http://localhost:3000/mcp",
        "headers": {
          "Authorization": "Bearer your-api-token",
          "User-Agent": "MCP-Client/3.0.1"
        },
        "enableDnsRebindingProtection": true,
        "allowedHosts": ["127.0.0.1", "localhost"],
        "reconnectDelay": 1000,
        "maxReconnectAttempts": 5
      },
      "enabled": true,
      "autoReconnect": true,
      "timeout": 30000,
      "tags": ["ai", "assistant", "modern"]
    },
    "legacy-tools-server": {
      "id": "legacy-tools-server",
      "name": "Legacy Tools Server",
      "description": "Legacy server with SSE fallback support",
      "transport": {
        "type": "http",
        "url": "http://localhost:3001/mcp",
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enabled": true,
      "timeout": 15000,
      "tags": ["tools", "legacy"]
    },
    "local-python-server": {
      "id": "local-python-server",
      "name": "Local Python Server",
      "description": "Local Python MCP server via stdio",
      "transport": {
        "type": "stdio",
        "command": "python3",
        "args": ["./servers/python/mcp-server.py"],
        "cwd": "./examples",
        "env": {
          "PYTHONPATH": "./lib",
          "MCP_DEBUG": "true"
        }
      },
      "enabled": true,
      "autoReconnect": false,
      "timeout": 45000,
      "tags": ["python", "local", "stdio"]
    },
    "websocket-realtime": {
      "id": "websocket-realtime",
      "name": "WebSocket Realtime Server",
      "description": "Realtime communication via WebSocket",
      "transport": {
        "type": "websocket",
        "url": "ws://localhost:8080/mcp",
        "headers": {
          "Sec-WebSocket-Protocol": "mcp-v1"
        }
      },
      "enabled": true,
      "autoReconnect": true,
      "timeout": 60000,
      "tags": ["websocket", "realtime"]
    }
  },
  "defaults": {
    "timeout": 30000,
    "autoReconnect": true,
    "maxReconnectAttempts": 3,
    "reconnectDelay": 1000
  }
}