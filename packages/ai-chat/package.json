{
  "name": "@deepracticex/ai-chat",
  "version": "0.5.0",
  "description": "Universal AI chat client with intelligent tool calling format adapter - supports OpenAI, Claude, Kimi, and any OpenAI-compatible APIs with robust error handling",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist"
  },
  "keywords": [
    "ai",
    "chat",
    "openai",
    "claude",
    "kimi",
    "moonshot",
    "llm",
    "streaming",
    "tools",
    "function-calling",
    "tool-adapter",
    "format-adapter",
    "ai-client",
    "mcp",
    "model-context-protocol",
    "json-parser",
    "error-handling",
    "universal-adapter"
  ],
  "author": "DeeChat Team",
  "license": "MIT",
  "dependencies": {
    "eventemitter3": "^5.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
